# Copy these values into the process environment; do not commit the real values.
FLASK_ENV=production
FLASK_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-12-chars
ALICE_PASSWORD=replace-with-a-unique-user-password-at-least-12-chars
SESSION_COOKIE_SECURE=1
DATABASE_PATH=data/users.db
